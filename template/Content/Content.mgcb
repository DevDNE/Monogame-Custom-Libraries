
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#


#---------------------------------- Content ---------------------------------#

#begin fonts/Arial.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Compressed
/build:fonts/Arial.spritefont

# ---------------------------------------------------------------------------
# Sprite path. Copy this block for each new texture; replace the filename in
# both the #begin line and the /build line.
#
# TextureFormat=Color is deliberate and load-bearing. The font above uses
# Compressed (DXT block compression), which is fine for glyph atlases but
# mangles the hard 1px colour boundaries pixel art depends on. Never use
# Compressed for sprites.
#
# ResizeToPowerOfTwo/MakeSquare stay False so a 32x32 source stays 32x32 —
# padding would silently shift every source rectangle you compute.
#
# Pair this with SamplerState.PointClamp in SpriteBatch.Begin (see
# GameStates/PlayState.cs). Without it the default LinearClamp filter blurs
# pixel art the moment it's scaled.
# ---------------------------------------------------------------------------

#begin sprites/placeholder.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyColor=255,0,255,255
/processorParam:ColorKeyEnabled=False
/processorParam:GenerateMipmaps=False
/processorParam:PremultiplyAlpha=True
/processorParam:ResizeToPowerOfTwo=False
/processorParam:MakeSquare=False
/processorParam:TextureFormat=Color
/build:sprites/placeholder.png
