# A wall torch. The only warm object in the game and the reason torch-* is in
# the palette at all — it justifies the light everything else is lit by.
name roguelike-torch
size 16 16
key o outline
key f torch-0-shadow
key F torch-1
key W torch-3-flame
key T crypt-3
pixels
.......ff.......
......fFFf......
.....fFFFFf.....
.....fFWWFf.....
......fFFf......
.......ff.......
*8 ......oTTo......
......oooo......
................
